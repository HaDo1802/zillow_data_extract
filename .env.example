# Copy this file to .env and fill in the values. Never commit .env to git.
# Generate AIRFLOW_FERNET_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Zillow API (RapidAPI) ──────────────────────────────────────────────────────
RAPID_API_KEY=your_rapidapi_key_here

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=real-estate-data
SUPABASE_RAW_PREFIX=raw
SUPABASE_TRANSFORMED_PREFIX=transformed

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=your_airflow_ui_password_here
AIRFLOW_UID=50000

# ── Airflow Postgres (Airflow metadata DB) ────────────────────────────────────
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=your_airflow_db_password_here
AIRFLOW_POSTGRES_DB=airflow_db

# ── App Postgres (ETL data DB, shared with Airflow Postgres service) ──────────
POSTGRES_USER=db_user
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=docker_real_estate
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Email notifications (Gmail SMTP) ─────────────────────────────────────────
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password_here
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
RECIPIENT_EMAIL=your_email@gmail.com

# ── Airflow SMTP (mirrors above — Airflow reads its own prefixed vars) ────────
AIRFLOW_SMTP_HOST=smtp.gmail.com
AIRFLOW_SMTP_PORT=587
AIRFLOW_SMTP_USER=your_email@gmail.com
AIRFLOW_SMTP_PASSWORD=your_gmail_app_password_here
AIRFLOW_SMTP_MAIL_FROM=your_email@gmail.com
